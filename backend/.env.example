# DropRoom backend configuration
# Copy to `.env` (same directory) and adjust for your environment.
# Every value here matches a field in `app/core/config.py`.

# ---------------------------------------------------------------- Application
APP_NAME=DropRoom API
ENVIRONMENT=development          # development | test | production
DEBUG=false
# Public URL of the API (used to build share/owner links)
BASE_URL=http://localhost:8000
# Create missing tables on startup (dev convenience). Use Alembic in production.
AUTO_CREATE_TABLES=true

# ------------------------------------------------------------------ Database
# SQLAlchemy async URL.
#   PostgreSQL (production):  postgresql+asyncpg://USER:PASS@HOST:PORT/DBNAME
#   SQLite (local dev/tests): sqlite+aiosqlite:///./droproom.db
DATABASE_URL=postgresql+asyncpg://droproom:droproom@localhost:5432/droproom

# ------------------------------------------------------------- Sessions/CSRF
SESSION_COOKIE_NAME=dr_session
CSRF_COOKIE_NAME=dr_csrf
COOKIE_SECURE=false              # set true behind HTTPS
# Session / cookie lifetime in seconds (12h)
SESSION_TTL_SECONDS=43200
# How often the cleanup scheduler runs in seconds
CLEANUP_INTERVAL_SECONDS=60
# Secret used to sign CSRF tokens and owner/access-token signatures. CHANGE ME.
CSRF_SECRET=change-me-please-generate-a-long-random-string

# --------------------------------------------------------------------- Rooms
ROOM_CODE_LENGTH=6
MAX_ROOM_LIFETIME_SECONDS=86400
# Allowed room lifetimes (seconds) — shown in the frontend dropdown
ROOM_LIFETIME_OPTIONS_SECONDS=[1800,3600,21600,43200,86400]
DEFAULT_ROOM_LIFETIME_SECONDS=3600
# Show "room expiring" warning when remaining time is below this (seconds)
ROOM_EXPIRING_THRESHOLD_SECONDS=300

# -------------------------------------------------------------------- Limits
MAX_USERS_PER_ROOM=10
MAX_FILE_SIZE_BYTES=1073741824       # 1 GiB per file
MAX_ROOM_STORAGE_BYTES=2147483648    # 2 GiB per room
MAX_FILES_PER_ROOM=100
MAX_MESSAGE_LENGTH=1000
CHAT_SCROLLBACK=200

# ----------------------------------------------------------- Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
CREATE_ROOM_LIMIT=5
GENERIC_LIMIT=120
JOIN_BY_CODE_LIMIT=6
CHAT_LIMIT=20
UPLOAD_LIMIT=30

# ------------------------------------------------------------------ Storage
STORAGE_BACKEND=local            # local | s3
# Local filesystem backend (relative to the container/process working dir)
STORAGE_LOCAL_DIR=/tmp/droproom-storage

# S3/MinIO backend (used when STORAGE_BACKEND=s3)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=droproom
S3_REGION=us-east-1
S3_VERIFY_TLS=true

# --------------------------------------------------------------------- CORS
CORS_ORIGINS=["http://localhost:3000"]