# DropRoom docker-compose environment
# Copy to `.env` in the `infra/` directory and adjust.

# --- PostgreSQL ---
POSTGRES_USER=droproom
POSTGRES_PASSWORD=droproom
POSTGRES_DB=droproom

# --- MinIO (S3-compatible storage) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# --- Backend ---
# Same URL as the compose DB service above
DATABASE_URL=postgresql+asyncpg://droproom:droproom@db:5432/droproom
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=droproom
S3_REGION=us-east-1
CSRF_SECRET=change-me-please-generate-a-long-random-string
COOKIE_SECURE=false
BASE_URL=http://localhost:3000

# --- Frontend ---
# Public origin where the browser reaches the frontend
NEXT_PUBLIC_WS_URL=ws://localhost:3000